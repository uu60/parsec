{
  "version": 4,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Developer build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PARSEC_BUILD_DATABASE": "ON",
        "PARSEC_BUILD_BENCHMARKS": "ON",
        "PARSEC_BUILD_EXPERIMENTS": "ON",
        "PARSEC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PARSEC_BUILD_DATABASE": "ON",
        "PARSEC_BUILD_BENCHMARKS": "ON",
        "PARSEC_BUILD_EXPERIMENTS": "ON",
        "PARSEC_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ci",
      "displayName": "CI core and correctness tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PARSEC_BUILD_DATABASE": "OFF",
        "PARSEC_BUILD_BENCHMARKS": "OFF",
        "PARSEC_BUILD_EXPERIMENTS": "OFF",
        "PARSEC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-database",
      "displayName": "CI database build and experiment checks",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-database",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PARSEC_BUILD_DATABASE": "ON",
        "PARSEC_BUILD_BENCHMARKS": "OFF",
        "PARSEC_BUILD_EXPERIMENTS": "ON",
        "PARSEC_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-sanitizers",
      "inherits": "ci",
      "displayName": "CI sanitizers",
      "binaryDir": "${sourceDir}/build/ci-sanitizers",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "PARSEC_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "ci",
      "configurePreset": "ci"
    },
    {
      "name": "ci-database",
      "configurePreset": "ci-database"
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ci-database",
      "configurePreset": "ci-database",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "database"
        }
      }
    },
    {
      "name": "ci-sanitizers",
      "configurePreset": "ci-sanitizers",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
